<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <PropertyGroup>
    <RuntimeTargetFrameworks>net8.0;net10.0</RuntimeTargetFrameworks>
  </PropertyGroup>

  <!-- Package -->
  <PropertyGroup>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/LordMike/MBW.HassMQTT</PackageProjectUrl>
  </PropertyGroup>

  <PropertyGroup>
    <RepositoryUrl>https://github.com/LordMike/MBW.HassMQTT</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <!-- Nuget -->
  <PropertyGroup>
    <PackageTags>home-assistant hass mqtt discovery</PackageTags>
  </PropertyGroup>

</Project>
